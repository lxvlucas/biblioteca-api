@startuml
title Adicionar exemplar
left to right direction
skinparam classAttributeIconSize 0

package "Serviços" {
    class ExemplarService {
        +registrarExemplar(livroId: Long): Exemplar
        +excluirExemplar(id: Long): void
    }
}

package "Repositórios" {
    interface LivroRepository
    interface ExemplarRepository
    interface EmprestimoRepository
}

package "Entidades" {
    class Exemplar {
    -id: Long
    -livro: Livro
    }

    class Livro {
        -id: Long
        -titulo: String
        -autor: Autor
        -edicao: Integer
        -ano: Integer
        -categoria: Categoria
        -isbn: String
    }
    class Emprestimo {
    -id: Long
    -dataEmprestimo: LocalDate
    -dataDevolucaoPrevista: LocalDate
    -dataDevolucao: LocalDate
    }
}
ExemplarService ..> EmprestimoRepository : verifica histórico
ExemplarService ..> LivroRepository : busca o livro
ExemplarService ..> ExemplarRepository : consulta e cria
ExemplarService ..> Exemplar : registra

Livro "1" -- "0..*" Exemplar
Exemplar "1" -- "0..*" Emprestimo

note bottom of ExemplarService
    Só exclui exemplares sem empréstimos registrados,
    incluindo empréstimos já encerrados.
end note

@enduml